# Copy to .env at the repository root. Never commit real credentials.
APP_NAME=燃气安全知识图谱系统
HOST=127.0.0.1
PORT=8000
RELOAD=false
# demo | neo4j. Demo is read-only, synthetic, and never persisted.
GRAPH_BACKEND=demo
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Reserved contract; v1 does NOT call prediction or any LLM.
PREDICTION_BASE_URL=
